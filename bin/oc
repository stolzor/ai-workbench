#!/bin/sh
set -eu

root=$(CDPATH= cd -P -- "$(dirname "$0")/.." && pwd)
node_version=$(mise config get --file "$root/mise.toml" tools.node)
opencode_version=$(mise config get --file "$root/mise.toml" tools.opencode)

export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
unset OPENCODE_ENABLE_EXA

if [ "${1-}" = "--web" ]; then
  export OPENCODE_ENABLE_EXA=1
  shift
fi

exec mise exec "node@$node_version" "opencode@$opencode_version" -- opencode "$@"
